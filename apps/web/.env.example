# Craft Agents Web Client Configuration
# Copy to .env.local and fill in values

# --- Development Mode (no Entra ID) ---
# Static server token from CRAFT_SERVER_TOKEN
VITE_SERVER_TOKEN=

# Server WebSocket URL
VITE_SERVER_URL=ws://127.0.0.1:9100

# --- Production Mode (Entra ID) ---
# Azure AD / Entra ID tenant and app registration
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=

# HTTP API base URL (for file downloads, session exports)
# Defaults to window.location.origin if not set
VITE_API_URL=
